        "data_description": {
          "community": "The PJ Talk community of the projector. Factory default: SONY.",
          "host": "The hostname or IP address of the projector.",
          "port": "The PJ Talk port. Factory default: 53484."
        },
        "description": "Update the connection details of your projector."
      },
      "user": {
        "data": {
          "community": "Community",
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "community": "The PJ Talk community of the projector, found under Setup, Network, PJ Talk. Exactly four characters. Factory default: SONY.",
          "host": "The hostname or IP address of the projector, for example 10.10.10.10. Set Network Management to On in the projector's Setup menu, otherwise it will not accept connections while it is in standby and Home Assistant cannot switch it on.",
          "port": "The PJ Talk port. Factory default: 53484."
        },
        "description": "Enter the connection details of your Sony VPL projector."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "command_timeout": "Command timeout",
          "scan_interval_on": "Update interval while on",
          "scan_interval_settings": "Update interval for picture settings",
          "scan_interval_standby": "Update interval while in standby"
        },
        "data_description": {
          "command_timeout": "How long to wait for a reply. The projector normally answers within a second, but takes up to about three under load.",
          "scan_interval_on": "How often power, faults, input and lamp hours are read while the projector is on.",
          "scan_interval_settings": "How often the picture settings are read back. Only matters if you also change them with the projector's own remote control. Settings whose entity is disabled are never read at all.",
          "scan_interval_standby": "How often the projector is polled while it is off. Raise this if you do not need Home Assistant to notice quickly that it was switched on by hand."
        },
        "description": "The projector accepts one command at a time, so shorter intervals mean more load on it. The defaults suit a projector used daily."
      }
    }
  },
